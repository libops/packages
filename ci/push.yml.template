name: Packages
on:
  schedule:
    - cron: '11 3 * * 0'
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:
    inputs:
      all:
        description: Build all packages
        type: boolean
        default: false
permissions: {}
concurrency:
  group: packages-${{ github.event_name == 'pull_request' && github.event.pull_request.number || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
jobs:
  plan:
    timeout-minutes: 10
    permissions:
      contents: read
    runs-on: ubuntu-26.04
    outputs:
      targets: ${{ steps.plan.outputs.targets }}
      local-builder: ${{ steps.plan.outputs.local-builder }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-go@d8cbb8045d7f43706b9177cceb36c1f91a6644d5 # v7.1.0
        with:
          go-version-file: go.mod
          cache: false
      - name: Require the selected Go toolchain
        run: echo 'GOTOOLCHAIN=local' >> "$GITHUB_ENV"
      - name: Validate pipeline
        run: |
          make dev-check
      - id: plan
        env:
          BEFORE: ${{ github.event.before }}
          PR_BASE: ${{ github.event.pull_request.base.sha }}
          BUILD_ALL: ${{ github.event_name == 'schedule' || inputs.all || false }}
        run: |
          make --silent plan >> "$GITHUB_OUTPUT"
  install-check:
    needs: plan
    if: needs.plan.outputs.targets != '[]'
    timeout-minutes: 25
    permissions:
      contents: read
    runs-on: ubuntu-26.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
      - uses: actions/setup-go@d8cbb8045d7f43706b9177cceb36c1f91a6644d5 # v7.1.0
        with:
          go-version-file: go.mod
          cache: false
      - name: Require the selected Go toolchain
        run: echo 'GOTOOLCHAIN=local' >> "$GITHUB_ENV"
      - name: Test carrier selection against newer distro packages
        run: make dev-test-install
# @@JOBS@@
  required-checks:
    timeout-minutes: 5
    name: Required checks
    if: ${{ always() }}
    needs: ['@@NEEDS@@']
    runs-on: ubuntu-26.04
    env:
      RESULTS: ${{ toJSON(needs) }}
      TARGETS: ${{ needs.plan.outputs.targets }}
      FORK: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository }}
    steps:
      - name: Check every selected build and test
        run: |
          if ! jq -e '.plan.result == "success"' <<< "$RESULTS" > /dev/null; then
            echo '::error::Planning failed or was cancelled; see the plan job logs.'
            exit 1
          fi
          if ! jq -en --arg targets "$TARGETS" '$targets | fromjson | type == "array" and all(.[]; type == "string")' > /dev/null 2>&1; then
            echo '::error::Planning produced missing or invalid targets; expected a JSON array of target names.'
            exit 1
          fi
          jq -e --argjson targets "$TARGETS" '
            .plan.result == "success" and
            (if ($targets | length) == 0 then .["install-check"].result == "skipped"
             else .["install-check"].result == "success" end) and
            all($targets[]; . as $target |
              $ARGS.named.results["build-" + $target].result == "success" and
              (($ARGS.named.fork == "true" and $ARGS.named.results["test-" + $target].result == "skipped") or
               $ARGS.named.results["test-" + $target].result == "success"))
          ' --arg fork "${FORK:-false}" --argjson results "$RESULTS" <<< "$RESULTS"

  docs-build:
    needs: required-checks
    if: ${{ always() && !cancelled() && github.ref == 'refs/heads/main' && github.event_name != 'pull_request' && needs.required-checks.result == 'success' }}
    permissions:
      contents: read
      packages: read
    runs-on: ubuntu-26.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
      - uses: actions/setup-go@d8cbb8045d7f43706b9177cceb36c1f91a6644d5 # v7.1.0
        with:
          go-version-file: go.mod
          cache: false
      - name: Require the selected Go toolchain
        run: echo 'GOTOOLCHAIN=local' >> "$GITHUB_ENV"
      - name: Refresh published package reference
        env:
          REGISTRY_USER: ${{ github.actor }}
          REGISTRY_PASSWORD: ${{ github.token }}
        run: make docs-packages
      - name: Build strict documentation
        run: make docs-build
      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5
        with:
          path: site
  docs-deploy:
    if: ${{ always() && !cancelled() && github.ref == 'refs/heads/main' && github.event_name != 'pull_request' && needs.docs-build.result == 'success' }}
    needs: docs-build
    runs-on: ubuntu-26.04
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    concurrency:
      group: pages-deploy
      cancel-in-progress: false
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d # v6
      - uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5
        id: deployment
