maintainer="LibOps <libops@users.noreply.github.com>"
# Official Go source; no downstream source patches.
pkgname=go127
pkgver=1.27.4
pkgrel=6
pkgdesc="Go 1.27 toolchain for public-facing services"
url="https://go.dev/"
arch="x86_64 aarch64"
license="BSD-3-Clause"
depends="binutils gcc musl-dev"
makedepends="bash go"
checkdepends="git-daemon"
source="https://go.dev/dl/go$pkgver.src.tar.gz"
builddir="$srcdir/go"
options="!strip"

build() {
    export GOROOT_BOOTSTRAP=/usr/lib/go
    export GOROOT_FINAL=/usr/lib/go
    export GOTOOLCHAIN=local
    cd src
    ./make.bash
}

check() {
    # abuild places GOTMPDIR outside os.TempDir; upstream linker security tests
    # must create fixtures beneath the same trusted temporary root.
    unset GOTMPDIR GOFLAGS
    export GOROOT="$builddir"
    export GOTOOLCHAIN=local
    export GOENV=off
    # Alpine also excludes TSAN: it needs ASLR controls denied by containers.
    # Keep all other sanitizer cases and the rest of the upstream suite.
    if [ "$CARCH" = x86_64 ]; then
        # musl's fixed SIGSTKSZ is too small on newer GitHub AMD64 kernels.
        # Apply exact skips only in this disposable test stage, so dist's
        # internal/external/static/PIE variants honor them too.
        sed -i 's/^func TestSigStackSwapping(t \*testing.T) {/& t.Skip("musl SIGSTKSZ is below runner kernel minimum");/' src/runtime/crash_cgo_test.go
        sed -i 's/^func TestSigaltstack(t \*testing.T) {/& t.Skip("musl SIGSTKSZ is below runner kernel minimum");/' src/cmd/cgo/internal/test/cgo_unix_test.go
    fi
    cd src
    # dist clears GOFLAGS; run only the sanitizer package directly with its
    # exact exclusion. All runtime and cgo linker variants remain in dist.
    ./run.bash --no-rebuild -run='!^cmd/cgo/internal/testsanitizers$' || return 1
    ../bin/go test -trimpath=false -count=1 -short -timeout=10m -skip='^TestTSAN$' cmd/cgo/internal/testsanitizers
}

package() {
    mkdir -p "$pkgdir/usr/lib/go" "$pkgdir/usr/bin"
    cp -a bin pkg src lib misc api doc go.env VERSION LICENSE PATENTS "$pkgdir/usr/lib/go/"
    # Binary fixtures under testdata are for upstream tests, not the installed compiler.
    find "$pkgdir/usr/lib/go/src" -type d -name testdata -prune -exec rm -rf {} +
    ln -s /usr/lib/go/bin/go "$pkgdir/usr/bin/go"
    ln -s /usr/lib/go/bin/gofmt "$pkgdir/usr/bin/gofmt"
}

