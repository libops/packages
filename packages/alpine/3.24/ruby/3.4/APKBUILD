maintainer="LibOps <libops@users.noreply.github.com>"
# Alpine musl compatibility settings and patch, retaining bundled gems and full tests.
# Adapted from: https://github.com/alpinelinux/aports/blob/787e3b0f296710b6edc170d0c1df3ffda99b2c02/main/ruby/APKBUILD
pkgname=ruby34
pkgver=3.4.13
pkgrel=7
pkgdesc="Ruby 3.4"
url="https://www.ruby-lang.org/"
arch="all"
license="Ruby AND BSD-2-Clause AND MIT"
depends="ca-certificates"
subpackages="$pkgname-doc"
checkdepends="bash tzdata"
makedepends="autoconf bison gdbm-dev gmp-dev libffi-dev libucontext-dev linux-headers ncurses-dev openssl-dev readline-dev yaml-dev zlib-dev"
source="https://cache.ruby-lang.org/pub/ruby/3.4/ruby-$pkgver.tar.gz
    fix-get_main_stack.patch
    APORTS-NOTICE
"
builddir="$srcdir/ruby-$pkgver"

build() {
    # Alpine's runtime settings avoid unsafe aliasing/frame omission and -Os.
    export CFLAGS="${CFLAGS/-Os/-O2} -fno-omit-frame-pointer -fno-strict-aliasing"
    export CPPFLAGS="${CPPFLAGS/-Os/-O2} -fno-omit-frame-pointer -fno-strict-aliasing"
    export LIBS="-lucontext"
    export INSTALL=install
    export ac_cv_func_isnan=yes ac_cv_func_isinf=yes
    ./configure --build=$CBUILD --host=$CHOST --prefix=/usr \
        --sysconfdir=/etc --mandir=/usr/share/man --infodir=/usr/share/info \
        --with-sitedir=/usr/local/lib/site_ruby --enable-pthread --disable-rpath \
        --with-mantype=man --enable-shared --disable-install-doc --disable-yjit
    make
}

check() {
    # Both suites exercise the normal runtime stack configuration.
    unset RUBY_THREAD_VM_STACK_SIZE RUBY_THREAD_MACHINE_STACK_SIZE
    make test
    # This assertion expects glibc's libc.so, not musl's dynamic loader name.
    make test-all TESTOPTS='--name=!/^test_dlopen_linker_script_group_linux$/'
}

package() {
    make DESTDIR="$pkgdir" install
    # Match aports: site_ruby belongs to local administrators, not the APK.
    if [ -d "$pkgdir/usr/local" ]; then
        test -z "$(find "$pkgdir/usr/local" ! -type d -print -quit)" || return 1
        rm -r "$pkgdir/usr/local"
    fi
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
    install -Dm644 "$srcdir/APORTS-NOTICE" "$pkgdir/usr/share/licenses/$pkgname/APORTS-NOTICE"
}

