FROM python:3.13.14-slim-bookworm@sha256:9d7f287598e1a5a978c015ee176d8216435aaf335ed69ac3c38dd1bbb10e8d64 AS tools
COPY requirements-docs.txt /tmp/requirements-docs.txt
RUN python -m pip install --disable-pip-version-check --no-cache-dir --require-hashes -r /tmp/requirements-docs.txt
WORKDIR /workspace
ENTRYPOINT ["zensical"]

FROM tools AS build
COPY zensical.toml ./
COPY docs ./docs
RUN zensical build --clean --strict

FROM scratch AS site
COPY --from=build /workspace/site/ /
