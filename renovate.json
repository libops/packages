  "enabledManagers": [
    "custom.regex",
    "github-actions",
    "dockerfile",
    "gomod"
  ],
  "extends": [
    "config:best-practices",
    ":rebaseStalePrs"
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/^ci/push\\.yml\\.template$/"
    ]
  },
  "ignorePaths": [
    "**/tests/**",
    ".github/workflows/push.yml"
  ],
  "packageRules": [
    {
      "automerge": false,
      "automergeType": "pr",
      "ignoreUnstable": true,
      "matchDepNames": [
        "*-source"
      ],
      "platformAutomerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "postUpgradeTasks": {
        "commands": [
          "make dev-generate"
        ],
        "executionMode": "branch",
        "fileFilters": [
          ".github/workflows/push.yml",
          ".github/actionlint.yaml"
        ]
      }
    },
    {
      "allowedVersions": "/^1\\.26\\.[0-9]+$/",
      "matchDepNames": [
        "alpine-3-24-go-1-26-source"
      ],
